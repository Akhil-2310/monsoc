CHAIN_ID=10143
RPC_URL=https://testnet-rpc.monad.xyz
RELAY_PRIVATE_KEY=0x...
LABELER_PRIVATE_KEY=0x...
DB_PATH=./relay-testnet.db
PUBLIC_URL=http://localhost:8787
LOG_RANGE=100
INDEX_INTERVAL_MS=1500
ANCHOR_INTERVAL_MS=180000

# ImageKit uploads (optional)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/your_id
IMAGEKIT_PUBLIC_KEY=public_...
IMAGEKIT_PRIVATE_KEY=private_...

# reputation warm-up (hours until account age counts fully); 168 = a week. 1 is handy on testnets.
REPUTATION_WARMUP_HOURS=168
SCOUT_ROOT_INTERVAL_MS=600000
JOBS_INTERVAL_MS=30000

# optional: AI topic labeler + natural-language feed builder (Claude Opus 5.5 by default)
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
